int n;
int total;
bool even;

n = 3;
total = 0;

while (n > 0) {
    even = n % 2 == 0;
    if (even) {
        total = total + n * 2 - 1;
    } else {
        if (n > 1) {
            total = total + (n + 1) * 3;
        } else {
            total = total + n;
        }
    }
    n = n - 1;
}

print total;
